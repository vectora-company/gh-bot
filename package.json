{
  "name": "@vectora/gh-bot",
  "version": "0.1.0",
  "description": "Self-hosted GitHub automation powered by Vectora Engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vectora-gh-bot": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/cli.ts start\" \"pnpm --dir apps/web dev\"",
    "dev:bun": "concurrently -k \"bun --watch src/cli.ts start\" \"pnpm --dir apps/web dev\"",
    "start": "node dist/cli.js start",
    "start:bun": "bun run dist/cli.js start",
    "doctor": "tsx src/cli.ts doctor",
    "build": "pnpm --dir apps/web build && tsc -p tsconfig.build.json",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --dir apps/web typecheck && tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/bun": "1.0.1",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "1.6.3",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
