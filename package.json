{
  "name": "@vectora/gh-bot",
  "version": "0.1.0",
  "description": "Self-hosted GitHub automation powered by Vectora Engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vectora-gh-bot": "app/dist/cli.js"
  },
  "files": [
    "app/dist",
    "app/.output",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config app/vite.config.ts --host 127.0.0.1",
    "dev:bun": "bun --bun ./node_modules/vite/bin/vite.js --config app/vite.config.ts --host 127.0.0.1",
    "start": "node app/dist/cli.js start",
    "start:bun": "bun run app/dist/cli.js start",
    "doctor": "tsx app/src/cli.ts doctor",
    "build": "pnpm build:start && pnpm build:cli",
    "build:start": "vite build --config app/vite.config.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p app/tsconfig.json && tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "motion": "14.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nitro": "3.0.261103-rc",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
