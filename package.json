{
  "name": "@vectora/gh-bot",
  "version": "0.1.0",
  "description": "Self-hosted GitHub automation powered by Vectora Engine",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vectora-gh-bot": "app/dist/server/cli.js"
  },
  "files": [
    "app/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsx watch app/src/server/cli.ts start\" \"vite --config app/vite.config.ts\"",
    "dev:bun": "concurrently -k \"bun --watch app/src/server/cli.ts start\" \"vite --config app/vite.config.ts\"",
    "start": "node app/dist/server/cli.js start",
    "start:bun": "bun run app/dist/server/cli.js start",
    "doctor": "tsx app/src/server/cli.ts doctor",
    "build": "pnpm build:frontend && tsc -p tsconfig.build.json",
    "build:frontend": "vite build --config app/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p app/tsconfig.json && tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@hono/bun": "1.0.1",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "1.6.3",
    "hono": "^4.9.0",
    "motion": "14.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
