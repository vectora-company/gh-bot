# Web control panel and API listener. Keep local installs on loopback.
VECTORA_GH_BOT_HOST=127.0.0.1
VECTORA_GH_BOT_PORT=3210
VECTORA_GH_BOT_DATA_DIR=~/.local/share/vectora-gh-bot

# Optional override for the Vectora Services API, mainly for development.
VECTORA_SERVICES_URL=https://services.vectora.company

# Do not put account tokens, provider keys, GitHub credentials, encryption keys,
# or database passwords in this file. Use the setup flow or your secret manager.
